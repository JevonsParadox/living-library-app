#!/bin/bash
# =====================================================================
# Pre-commit safety net. Documented in docs/security/supply-chain.md.
#
# Install once: bash scripts/install-git-hooks.sh
# Bypass (NOT recommended): git commit --no-verify
# =====================================================================

set -e

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && exit 0

FAIL=0

# ---- 1. Block .env* files (except .env.example) ----
ENV_LEAK=$(echo "$STAGED" | grep -E '^\.env' | grep -v '^\.env\.example$' || true)
if [ -n "$ENV_LEAK" ]; then
  echo "❌ Refusing to commit .env files:"
  echo "$ENV_LEAK" | sed 's/^/   /'
  echo "   These should stay local. Add to .gitignore if missing."
  FAIL=1
fi

# ---- 2. Block known secret patterns in any staged diff ----
check_pattern() {
  local name="$1"
  local pattern="$2"
  local hits=""
  for f in $STAGED; do
    [ -f "$f" ] || continue
    if git diff --cached -- "$f" | grep -qE "$pattern"; then
      hits="$hits $f"
    fi
  done
  if [ -n "$hits" ]; then
    echo "❌ Possible $name detected in:$hits"
    return 1
  fi
  return 0
}

check_pattern "Anthropic API key (sk-ant-api03-...)" \
  'sk-ant-api03-[A-Za-z0-9_-]{40,}' || FAIL=1
check_pattern "OpenAI project key (sk-proj-...)" \
  'sk-proj-[A-Za-z0-9_-]{40,}' || FAIL=1
check_pattern "AWS access key ID (AKIA...)" \
  'AKIA[A-Z0-9]{16}' || FAIL=1
check_pattern "Clerk live secret (sk_live_...)" \
  'sk_live_[A-Za-z0-9]{32,}' || FAIL=1
check_pattern "GitHub classic PAT (ghp_...)" \
  'ghp_[A-Za-z0-9]{36}' || FAIL=1
check_pattern "GitHub fine-grained PAT (github_pat_...)" \
  'github_pat_[A-Za-z0-9_]{82,}' || FAIL=1
# Supabase service-role JWT — base64 of "service_role" is "c2VydmljZV9yb2xl"
# and lives inside the payload section of the JWT.
check_pattern "Supabase service-role JWT" \
  'eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_./+-]*c2VydmljZV9yb2xl[A-Za-z0-9_./+-]*' || FAIL=1
check_pattern "Google API key (AIza...)" \
  'AIza[A-Za-z0-9_-]{35}' || FAIL=1

# ---- 3. Lockfile sanity — non-npmjs resolve URLs ----
if echo "$STAGED" | grep -qx 'package-lock.json'; then
  BAD=$(grep -oE '"resolved": "[^"]*"' package-lock.json | grep -v 'registry.npmjs.org' | grep -v '"resolved": ""' || true)
  if [ -n "$BAD" ]; then
    echo "❌ package-lock.json contains resolves to non-npmjs hosts:"
    echo "$BAD" | head -5 | sed 's/^/   /'
    FAIL=1
  fi
fi

if [ "$FAIL" -ne 0 ]; then
  echo
  echo "Commit blocked. If a check is a false positive, you can bypass with"
  echo "  git commit --no-verify"
  echo "but FIRST confirm the file you're committing doesn't actually contain a secret."
  exit 1
fi

exit 0
