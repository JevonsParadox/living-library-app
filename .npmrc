# =====================================================================
# Supply-chain hardening — primary defence against Shai-Hulud-class attacks.
# Reviewed in docs/security/supply-chain.md.
# =====================================================================

# Block install scripts from running by default. Most legitimate packages
# don't need them; the ones that do (sharp, esbuild, fsevents) ship
# platform-specific binaries via optionalDependencies, which works without
# scripts. Compromised packages exploit postinstall to exfiltrate creds.
#
# If a future legitimate dep needs a script, allow it explicitly for that
# install only (NEVER flip this default), and confirm the script does what
# you expect:
#   npm install <pkg> --ignore-scripts=false
ignore-scripts=true

# Warn loudly on known-vulnerable versions during install. CI also fails
# on any moderate+ advisory.
audit-level=moderate

# Disable the "fund" message spam so audit output is actually readable.
fund=false

# Quieter installs in CI; warn level still surfaces what matters.
loglevel=warn

# Refuse to fall back to git URLs or non-registry sources. Lockfile-lint
# also enforces this in the pre-commit hook.
prefer-offline=false
package-lock=true
